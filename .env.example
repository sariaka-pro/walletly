# Walletly - modèle de configuration
# Copier ce fichier vers `.env`, puis remplacer les valeurs d'exemple.
# Ne jamais placer de véritable secret dans ce fichier versionné.

# Backend Spring Boot
JWT_SECRET=remplacer_par_une_cle_secrete_longue_et_aleatoire
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/walletly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=remplacer_par_le_mot_de_passe_postgresql
SERVER_PORT=8081

# Frontend Angular
ANGULAR_API_URL=http://localhost:8081
API_URL=http://localhost:8081
FRONTEND_URL=http://localhost:4200

# PostgreSQL et Docker Compose
POSTGRES_DB=walletly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=remplacer_par_le_mot_de_passe_postgresql
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_CONTAINER_NAME=walletly-postgres
